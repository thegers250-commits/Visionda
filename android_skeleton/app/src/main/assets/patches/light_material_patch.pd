#N canvas 0 0 600 400 10;
#X obj 50 30 adc~;
#X obj 50 300 dac~;
#X obj 50 60 osc~ 4000;
#X obj 200 60 osc~ 3996;
#X obj 50 120 *~ 0.6;
#X obj 200 120 *~ 0.6;
#X obj 350 60 noise~;
#X obj 350 120 lop~ 12000;
#X obj 350 160 *~ 0.4;
#X obj 50 180 +~;
#X obj 200 180 +~;
#X obj 50 220 dac~;
#X floatatom 50 20 5 0 0 0 - - -;
#X floatatom 200 20 5 0 0 0 - - -;
#X text 50 10 leftFreq (Hz);
#X text 200 10 rightFreq (Hz);
#X text 350 10 materialDensity [0..1];
#X connect 3 0 5 0;
#X connect 2 0 4 0;
#X connect 4 0 9 0;
#X connect 5 0 10 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 1;
#X connect 9 0 11 0;
#X connect 10 0 11 1;
#X connect 11 0 1 0;
#X connect 11 1 1 1;
